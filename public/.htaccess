<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

RewriteCond %{HTTP_HOST} ^www\.geniovisual\.com\.br$ [NC]
RewriteRule ^ https://geniovisual.com.br%{REQUEST_URI} [R=301,L]

RewriteRule ^private(?:/|$) - [F,L,NC]
RewriteRule ^lib(?:/|$) - [F,L,NC]

RewriteRule ^index\.html$ - [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /index.html [L]
</IfModule>
